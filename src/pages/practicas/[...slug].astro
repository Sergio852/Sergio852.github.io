---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const practicas = await getCollection("practicas");

  return practicas.map((practica) => ({
    params: { slug: practica.id.replace(/\.md$/, "") },
    props: { practica }
  }));
}

const { practica } = Astro.props;
const { Content } = await render(practica);

const formattedDate = practica.data.date.toLocaleDateString("es-ES", {
  day: "numeric",
  month: "long",
  year: "numeric"
});
---

<Layout
  title={practica.data.title}
  description={practica.data.description}
>
  <article class="article">
    <a class="back" href="/asignaturas/">← Volver a asignaturas</a>

    <header class="article-header">
      <p class="subject">{practica.data.subject}</p>

      <h1>{practica.data.title}</h1>

      <p class="description">
        {practica.data.description}
      </p>

      <div class="meta">
        <time datetime={practica.data.date.toISOString()}>
          {formattedDate}
        </time>
        <span aria-hidden="true">·</span>
        <span>Documentación práctica</span>
      </div>

      <div class="tags" aria-label="Etiquetas">
        {practica.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>

    {practica.data.pdf && (
      <div class="actions" aria-label="Acciones del documento">
        <a
          class="primary-button"
          href={`/pdfs/${practica.data.pdf}`}
          target="_blank"
          rel="noopener"
        >
          <span aria-hidden="true">↗</span>
          Abrir documento PDF
        </a>

        <a
          class="secondary-button"
          href={`/pdfs/${practica.data.pdf}`}
          download
        >
          <span aria-hidden="true">↓</span>
          Descargar PDF
        </a>
      </div>
    )}

    <div class="content">
      <Content />
    </div>
  </article>
</Layout>

<script>
  function setupCodeCopyButtons() {
    const blocks = document.querySelectorAll(".content pre");

    blocks.forEach((pre) => {
      if (pre.parentElement?.classList.contains("code-block")) {
        return;
      }

      const code = pre.querySelector("code");
      if (!code) return;

      const wrapper = document.createElement("div");
      wrapper.className = "code-block";

      const header = document.createElement("div");
      header.className = "code-block-header";

      const language = document.createElement("span");
      language.className = "code-language";

      const languageClass = Array.from(code.classList).find((item) =>
        item.startsWith("language-")
      );

      language.textContent = languageClass
        ? languageClass.replace("language-", "")
        : "código";

      const button = document.createElement("button");
      button.className = "copy-code";
      button.type = "button";
      button.setAttribute("aria-label", "Copiar código al portapapeles");
      button.textContent = "Copiar";

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(code.innerText);
          button.textContent = "Copiado";
          button.classList.add("copied");

          window.setTimeout(() => {
            button.textContent = "Copiar";
            button.classList.remove("copied");
          }, 1600);
        } catch {
          button.textContent = "No disponible";

          window.setTimeout(() => {
            button.textContent = "Copiar";
          }, 1600);
        }
      });

      header.append(language, button);
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.append(header, pre);
    });
  }

  document.addEventListener("DOMContentLoaded", setupCodeCopyButtons);
</script>

<style>
  .article {
    max-width: 820px;
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-bottom: 58px;
    color: #aebeff;
    text-decoration: none;
  }

  .back:hover {
    color: #ffffff;
  }

  .article-header {
    padding-bottom: 30px;
    border-bottom: 1px solid #2b3040;
  }

  .subject {
    margin: 0 0 18px;
    color: #91a8ff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 800px;
    margin: 0;
    color: #f5f7ff;
    font-size: clamp(2.5rem, 7vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.065em;
  }

  .description {
    max-width: 680px;
    margin: 26px 0 18px;
    color: #bdc3d1;
    font-size: 1.18rem;
    line-height: 1.7;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: #7f8798;
    font-size: 0.9rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .tags span {
    padding: 6px 10px;
    border: 1px solid #343d64;
    border-radius: 999px;
    color: #cbd5ff;
    background: #1b2140;
    font-size: 0.78rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 52px;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 10px;
    font-weight: 750;
    text-decoration: none;
    transition: transform 0.2s, background 0.2s;
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-2px);
  }

  .primary-button {
    color: #10131c;
    background: #bdcaff;
  }

  .primary-button:hover {
    background: #d9e0ff;
  }

  .secondary-button {
    color: #d3dcff;
    border: 1px solid #4a5b9e;
    background: #1b2240;
  }

  .secondary-button:hover {
    background: #28345f;
  }

  .content {
    color: #c6cad5;
    font-size: 1.06rem;
    line-height: 1.82;
  }

  .content :global(h2),
  .content :global(h3),
  .content :global(h4) {
    margin-top: 2.5em;
    color: #f1f3fa;
    line-height: 1.2;
  }

  .content :global(h2) {
    padding-bottom: 10px;
    border-bottom: 1px solid #2b3040;
    font-size: 1.8rem;
  }

  .content :global(h3) {
    font-size: 1.35rem;
  }

  .content :global(p),
  .content :global(ul),
  .content :global(ol) {
    margin: 1.15em 0;
  }

  .content :global(li) {
    margin: 0.45em 0;
  }

  .content :global(a) {
    color: #b9c6ff;
  }

  .content :global(strong) {
    color: #f1f3fa;
  }

  .content :global(code) {
    padding: 0.18em 0.4em;
    border: 1px solid #343b5a;
    border-radius: 5px;
    color: #d7ddff;
    background: #1c2134;
    font-size: 0.9em;
  }

  .content :global(.code-block) {
    overflow: hidden;
    margin: 1.6em 0;
    border: 1px solid #303752;
    border-radius: 12px;
    background: #111522;
    box-shadow: 0 12px 30px #0002;
  }

  .content :global(.code-block-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 14px;
    border-bottom: 1px solid #303752;
    color: #8993aa;
    background: #191e2d;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .content :global(.copy-code) {
    padding: 5px 10px;
    border: 1px solid #44527f;
    border-radius: 6px;
    color: #cdd6ff;
    background: #202a4c;
    cursor: pointer;
    font: inherit;
    letter-spacing: normal;
    text-transform: none;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }

  .content :global(.copy-code:hover) {
    color: #ffffff;
    background: #31427a;
    transform: translateY(-1px);
  }

  .content :global(.copy-code.copied) {
    color: #142016;
    border-color: #8ed6a0;
    background: #9de0ad;
  }

  .content :global(pre) {
    overflow-x: auto;
    margin: 0;
    padding: 20px;
    border: 0;
    color: #e8ecff;
    background: #111522;
  }

  .content :global(pre code) {
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    font-size: 0.9rem;
  }

  .content :global(blockquote) {
    margin: 1.5em 0;
    padding: 12px 18px;
    border-left: 3px solid #91a8ff;
    color: #cbd1e1;
    background: #191e30;
  }

  .content :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
  }

  .content :global(th),
  .content :global(td) {
    padding: 10px 12px;
    border: 1px solid #34394a;
    text-align: left;
  }

  .content :global(th) {
    color: #f1f3fa;
    background: #1b2030;
  }

  .content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 28px auto;
    border: 1px solid #303649;
    border-radius: 12px;
    box-shadow: 0 14px 35px #0003;
  }

  @media (max-width: 620px) {
    .back {
      margin-bottom: 38px;
    }

    .actions {
      margin-bottom: 38px;
    }

    .content {
      font-size: 1rem;
    }
  }
</style>
