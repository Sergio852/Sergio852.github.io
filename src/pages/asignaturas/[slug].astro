---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  const asignaturas: Record<string, string> = {
    "seguridad-alta-disponibilidad": "Seguridad y Alta Disponibilidad",
    "implantacion-aplicaciones-web": "Implantación de Aplicaciones Web",
    "infraestructura-virtual": "Infraestructura Virtual",
    "administracion-sistemas-operativos": "Administración de Sistemas Operativos",
    "servicios-red-internet": "Servicios de Red e Internet",
    "bases-datos": "Bases de Datos",
    ingles: "Inglés",
    "proyecto-intermodular": "Proyecto Intermodular de Administración de Sistemas Informáticos en Red"
  };

  return Object.entries(asignaturas).map(([slug, name]) => ({
    params: { slug },
    props: { name }
  }));
}

const { name } = Astro.props;
const todasLasPracticas = await getCollection("practicas");

const practicas = todasLasPracticas
  .filter((practica) => practica.data.subject === name)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title={name}
  description={`Prácticas de ${name} documentadas por Sergio Mesa durante el ciclo ASIR.`}
>
  <section class="header">
    <a class="back" href="/asignaturas">← Todas las asignaturas</a>

    <p class="eyebrow">Módulo formativo</p>

    <h1>{name}</h1>

    <p class="intro">
      Prácticas y documentación elaboradas durante mi recorrido por el ciclo de
      Administración de Sistemas Informáticos en Red.
    </p>
  </section>

  {practicas.length === 0 ? (
    <p class="empty">
      Todavía no hay prácticas publicadas en esta asignatura.
    </p>
  ) : (
    <section class="grid">
      {practicas.map((practica) => (
        <article class="card">
          <p class="date">
            {practica.data.date.toLocaleDateString("es-ES", {
              day: "numeric",
              month: "long",
              year: "numeric"
            })}
          </p>

          <h2>{practica.data.title}</h2>

          <p>{practica.data.description}</p>

          <a href={`/practicas/${practica.id}`}>
            Leer práctica <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </section>
  )}
</Layout>

<style>
  .header {
    max-width: 820px;
    padding: 65px 0 45px;
  }

  .back {
    color: #b8c5ff;
    text-decoration: none;
  }

  .back:hover,
  .card a:hover {
    color: #ffffff;
  }

  .eyebrow {
    margin: 55px 0 14px;
    color: #8fa7ff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 800px;
    margin: 0;
    color: #f5f7ff;
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.07em;
  }

  .intro {
    max-width: 680px;
    margin: 26px 0 0;
    color: #aeb3c0;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 20px;
  }

  .card {
    display: flex;
    min-height: 250px;
    flex-direction: column;
    padding: 26px;
    border: 1px solid #2b2e38;
    border-radius: 18px;
    background: #17191f;
    transition: border-color 0.2s, transform 0.2s;
  }

  .card:hover {
    border-color: #8fa7ff;
    transform: translateY(-3px);
  }

  .date {
    margin: 0;
    color: #7f8798;
    font-size: 0.85rem;
  }

  .card h2 {
    margin: 22px 0 12px;
    color: #f1f3fa;
    font-size: 1.4rem;
    line-height: 1.25;
  }

  .card p:not(.date) {
    margin: 0 0 24px;
    color: #aeb3c0;
    line-height: 1.65;
  }

  .card a {
    margin-top: auto;
    color: #b8c5ff;
    font-weight: 700;
    text-decoration: none;
  }

  .card a span {
    display: inline-block;
    transition: transform 0.2s;
  }

  .card:hover a span {
    transform: translateX(4px);
  }

  .empty {
    color: #aeb3c0;
  }
</style>
