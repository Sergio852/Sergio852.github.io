---
import Layout from "../../layouts/Layout.astro";

const asignaturas = [
  {
    name: "Seguridad y Alta Disponibilidad",
    slug: "seguridad-alta-disponibilidad",
    description: "Seguridad informática, copias de seguridad, disponibilidad y recuperación."
  },
  {
    name: "Implantación de Aplicaciones Web",
    slug: "implantacion-aplicaciones-web",
    description: "Desarrollo, despliegue y mantenimiento de aplicaciones web."
  },
  {
    name: "Infraestructura Virtual",
    slug: "infraestructura-virtual",
    description: "Máquinas virtuales, contenedores, redes virtuales y almacenamiento."
  },
  {
    name: "Administración de Sistemas Operativos",
    slug: "administracion-sistemas-operativos",
    description: "Administración de Linux, Windows, usuarios, servicios y servidores."
  },
  {
    name: "Servicios de Red e Internet",
    slug: "servicios-red-internet",
    description: "Redes, DNS, DHCP, routing, SSH, VPN y servicios de Internet."
  },
  {
    name: "Bases de Datos",
    slug: "bases-datos",
    description: "Diseño, administración y consultas de bases de datos."
  },
  {
    name: "Inglés",
    slug: "ingles",
    description: "Prácticas, vocabulario y contenidos técnicos en inglés."
  },
  {
    name: "Proyecto Intermodular de Administración de Sistemas Informáticos en Red",
    slug: "proyecto-intermodular",
    description: "Integración de sistemas, redes, servicios y documentación en un proyecto técnico de ASIR."
  }
];
---

<Layout
  title="Asignaturas"
  description="Módulos y prácticas documentadas por Sergio Mesa durante el ciclo ASIR."
>
  <section class="header">
    <p class="eyebrow">Recorrido formativo</p>
    <h1>Asignaturas</h1>
    <p>
      Cada módulo reúne las prácticas, configuraciones y aprendizajes que voy
      documentando durante mi formación en ASIR.
    </p>
  </section>

  <section class="grid">
    {asignaturas.map((asignatura) => (
      <a class="card" href={`/asignaturas/${asignatura.slug}`}>
        <h2>{asignatura.name}</h2>
        <p>{asignatura.description}</p>
        <span>Ver prácticas <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </section>
</Layout>

<style>
  .header {
    max-width: 760px;
    padding: 70px 0 45px;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #8fa7ff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 18px;
    color: #f5f7ff;
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.07em;
  }

  .header p:last-child {
    margin: 0;
    color: #aeb3c0;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 20px;
  }

  .card {
    display: flex;
    min-height: 245px;
    flex-direction: column;
    padding: 26px;
    border: 1px solid #2b2e38;
    border-radius: 18px;
    color: inherit;
    background: #17191f;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, background 0.2s;
  }

  .card:hover {
    border-color: #8fa7ff;
    background: #1b1e29;
    transform: translateY(-3px);
  }

  .card h2 {
    margin: 0;
    color: #f1f3fa;
    font-size: 1.35rem;
    line-height: 1.25;
  }

  .card p {
    margin: 18px 0 24px;
    color: #aeb3c0;
    line-height: 1.6;
  }

  .card > span {
    margin-top: auto;
    color: #b8c5ff;
    font-weight: 700;
  }

  .card > span span {
    display: inline-block;
    transition: transform 0.2s;
  }

  .card:hover > span span {
    transform: translateX(4px);
  }
</style>
