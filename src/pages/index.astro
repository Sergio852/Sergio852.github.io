---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const practicas = await getCollection("practicas");

practicas.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
  title="Prácticas y proyectos"
  description="Blog personal de prácticas de sistemas, redes, bases de datos y desarrollo."
>
  <section class="hero">
    <p class="eyebrow">Blog técnico personal</p>

    <h1>Prácticas y proyectos</h1>

    <p class="intro">
      Un espacio donde documento mis prácticas de sistemas,
      redes, servidores, bases de datos y desarrollo.
    </p>
  </section>

  <section class="subjects-link">
    <p class="eyebrow">Organización</p>

    <h2>Explora por asignatura</h2>

    <p>
      Consulta las prácticas agrupadas según el módulo formativo.
    </p>

    <a href="/asignaturas">
      Ver todas las asignaturas →
    </a>
  </section>

  <section id="practicas">
    <div class="section-heading">
      <p class="eyebrow">Documentación</p>
      <h2>Últimas prácticas</h2>
    </div>

    {practicas.length === 0 ? (
      <p class="empty">
        Todavía no hay prácticas publicadas.
      </p>
    ) : (
      <div class="grid">
        {practicas.map((practica) => (
          <article class="card">
            <p class="subject">{practica.data.subject}</p>

            <h3>{practica.data.title}</h3>

            <p class="description">
              {practica.data.description}
            </p>

            <div class="tags">
              {practica.data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>

            <a
              class="read-more"
              href={`/practicas/${practica.id}`}
            >
              Leer práctica →
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .hero {
    padding: 80px 0 90px;
  }

  .eyebrow,
  .subject {
    color: #8fa7ff;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 800px;
    margin: 18px 0;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
  }

  h2 {
    font-size: 2.3rem;
  }

  .intro {
    max-width: 650px;
    color: #aeb3c0;
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .subjects-link {
    margin-bottom: 90px;
    padding: 28px;
    border: 1px solid #2b2e38;
    border-radius: 20px;
    background: #17191f;
  }

  .subjects-link p {
    color: #aeb3c0;
    line-height: 1.6;
  }

  .subjects-link a,
  .read-more {
    color: #b8c5ff;
    font-weight: 700;
    text-decoration: none;
  }

  .section-heading {
    margin-bottom: 28px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 20px;
  }

  .card {
    padding: 26px;
    border: 1px solid #2b2e38;
    border-radius: 20px;
    background: #17191f;
  }

  .card h3 {
    font-size: 1.45rem;
  }

  .description,
  .empty {
    color: #aeb3c0;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0;
  }

  .tags span {
    padding: 6px 10px;
    border-radius: 999px;
    color: #cbd4ff;
    background: #272d4a;
    font-size: 0.8rem;
  }
</style>
